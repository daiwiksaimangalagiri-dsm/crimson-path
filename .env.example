# Copy to .env and fill in. .env is gitignored; never commit it.

# Required to build roadmaps and chat. Each call is billed. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port for the API server (Vite proxies /api to it).
PORT=8787

# Optional. Shows "Save to Google Drive". See docs/setup.md section 6.
VITE_GOOGLE_CLIENT_ID=
